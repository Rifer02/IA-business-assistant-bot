# Copy this file to .env and fill in your values. NEVER commit .env or credentials.json.

# Telegram: create a bot with @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=

# Telegram user IDs allowed to use /admin and receive daily summaries (comma separated).
# Don't know yours? Start the bot and send /myid
ADMIN_TELEGRAM_IDS=

# Gemini API key (Google AI Studio) - has a free tier
GEMINI_API_KEY=
# Model name is configurable because Google renames/retires models over time
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets: the ID is the long string in the sheet URL
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Path to the service account key (JSON). Share your sheet with the service account email as Editor.
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Scheduling (cron syntax). Default: every day at 21:00
DAILY_SUMMARY_CRON=0 21 * * *
TIMEZONE=America/Argentina/Buenos_Aires